{
	"name": "pi-chonk",
	"version": "0.2.0",
	"description": "A pi extension that shows context-window fill with configurable chonk cats.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/somus/pi-chonk.git"
	},
	"homepage": "https://github.com/somus/pi-chonk#readme",
	"bugs": {
		"url": "https://github.com/somus/pi-chonk/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"context",
		"chonk"
	],
	"scripts": {
		"postinstall": "node scripts/install-font.mjs",
		"install-font": "node scripts/install-font.mjs",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "npm run check && npm run typecheck && npm test"
	},
	"files": [
		"src/",
		"assets/",
		"scripts/",
		"README.md",
		"LICENSE",
		"tsconfig.json"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@earendil-works/pi-coding-agent": "^0.79.0",
		"@earendil-works/pi-tui": "^0.79.0",
		"@types/node": "^24.13.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"publishConfig": {
		"access": "public"
	}
}
